# Node 24+. Copy to .env locally; never commit credentials.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
SYNC_INTERVAL_MINUTES=5
# Required for Microsoft Graph application authentication, provisioned by your M365 administrator.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
# Optional extra password for this local dashboard. Remote access is always disabled.
DASHBOARD_TOKEN=
