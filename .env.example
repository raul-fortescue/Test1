# Node 24+. Copy to .env locally; never commit credentials.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
SYNC_INTERVAL_MINUTES=5
# Required for Microsoft Graph application authentication, provisioned by your M365 administrator.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
# Required if HOST is not loopback; use a random secret of at least 32 characters.
# Cloud hosting must also provide HTTPS and private access controls.
DASHBOARD_TOKEN=
# Exact public HTTPS origin when hosted behind a reverse proxy.
PUBLIC_ORIGIN=
# Only behind Azure App Service with Authentication enabled and mandatory.
# AUTH_MODE=azure-easyauth
# ALLOWED_USER_EMAILS=your.authorized.account@example.com
